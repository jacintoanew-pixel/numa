# ==============================================================================
# NUMA — VARIABLES DE ENTORNO PARA PRODUCCIÓN
# ==============================================================================
# 1. Copia este archivo a `.env.production`: cp .env.production.example .env.production
# 2. Genera claves de 256 bits para cada secreto con: openssl rand -hex 32
# ==============================================================================

NODE_ENV=production
PORT=3000
BUILD_STANDALONE=true

# URL base de la aplicación
NEXT_PUBLIC_APP_URL=https://numa.example.com

# Base de datos PostgreSQL (opcional)
DATABASE_URL=postgresql://numa_user:TU_PASSWORD_AQUI@127.0.0.1:5432/numa_db?sslmode=prefer

# Claves de 256 bits (64 caracteres hexadecimales) — generar con: openssl rand -hex 32
SESSION_SIGNING_SECRET=generate_with_openssl_rand_hex_32
VAULT_MASTER_KEY=generate_with_openssl_rand_hex_32
VAULT_SECRET=cambiar_por_clave_hex_de_64_caracteres_generada_con_openssl_rand_hex_32
APP_SECRET=cambiar_por_clave_hex_de_64_caracteres_generada_con_openssl_rand_hex_32

# Integración con Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=generar_con_openssl_rand_hex_32

# Integración con Gemini (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
